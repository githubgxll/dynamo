{
  "uid": "dingo-context-ir",
  "title": "Context-IR",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "dingo",
    "context-ir"
  ],
  "panels": [
    {
      "id": 1,
      "title": "排队上限",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Gateway 配置的后端 queue_limit。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(namespace,backend) (dingo_context_ir_queue_limit{namespace=~\"$namespace\",backend=~\"$backend\"}))",
          "legendFormat": "{{backend}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "当前排队数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "尚未领取执行槽位的任务数。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(namespace,backend) (dingo_context_ir_queued{namespace=~\"$namespace\",backend=~\"$backend\"}))",
          "legendFormat": "{{backend}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "后端可用执行槽数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "调度器可选的健康 Worker 空闲槽位总数；扣除已有占用，按物理容量域去重，不把静态配置当实际容量。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(namespace,backend) (dingo_context_ir_available_execution_slots{namespace=~\"$namespace\",backend=~\"$backend\"}))",
          "legendFormat": "{{backend}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "执行中任务数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "已领取且尚未释放执行槽位的任务数，包含取消后仍在收尾的任务；不等于模型瞬间正在计算的数量。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(namespace,backend) (dingo_context_ir_inflight{namespace=~\"$namespace\",backend=~\"$backend\"}))",
          "legendFormat": "{{backend}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "后端排队任务",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max by(namespace,backend) (dingo_context_ir_queued{namespace=~\"$namespace\",backend=~\"$backend\"})",
          "legendFormat": "{{backend}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "后端执行槽位占用",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "max by(namespace,backend) (dingo_context_ir_inflight{namespace=~\"$namespace\",backend=~\"$backend\"})",
          "legendFormat": "{{backend}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "区间提交数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "所选时间范围内新增编译请求；无样本不伪造为 0。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(backend,model) (increase(dingo_context_ir_submitted_total{namespace=~\"$namespace\",backend=~\"$backend\"}[$__range]))",
          "legendFormat": "{{backend}} / {{model}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "区间终态数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "成功/失败/取消；expired 为留存过期事件，不作为再次编译。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(backend,state) (increase(dingo_context_ir_terminal_total{namespace=~\"$namespace\",backend=~\"$backend\",state!=\"expired\"}[$__range]))",
          "legendFormat": "{{backend}} / {{state}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "阶段平均耗时",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "按完成终态记录的阶段耗时；每个时间点使用滚动窗口。execution 包含 compile 等子阶段，不可各阶段相加。无观测时留空。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(backend,stage) (rate(dingo_context_ir_stage_duration_seconds_sum{namespace=~\"$namespace\",backend=~\"$backend\"}[$__rate_interval])) / sum by(backend,stage) (rate(dingo_context_ir_stage_duration_seconds_count{namespace=~\"$namespace\",backend=~\"$backend\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} / {{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "阶段观测数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "各阶段滚动窗口样本数；用于判断均值是否具有足够样本。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(backend,stage) (increase(dingo_context_ir_stage_duration_seconds_count{namespace=~\"$namespace\",backend=~\"$backend\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} / {{stage}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "输入预留空间",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "请求输入预算的预留字节数，不是进程 RSS。",
      "targets": [
        {
          "refId": "A",
          "expr": "max by(namespace,backend) (dingo_context_ir_reserved_bytes{namespace=~\"$namespace\",backend=~\"$backend\"})",
          "legendFormat": "{{backend}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "后端隔离状态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "0=未隔离，1=隔离。",
      "targets": [
        {
          "refId": "A",
          "expr": "max by(namespace,backend) (dingo_context_ir_quarantined{namespace=~\"$namespace\",backend=~\"$backend\"})",
          "legendFormat": "{{backend}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "data_source",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "current": {}
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${data_source}"
        },
        "query": {
          "query": "label_values(dingo_context_ir_max_inflight, namespace)",
          "refId": "namespace"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "backend",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${data_source}"
        },
        "query": {
          "query": "label_values(dingo_context_ir_max_inflight{namespace=~\"$namespace\"}, backend)",
          "refId": "backend"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      }
    ]
  }
}
