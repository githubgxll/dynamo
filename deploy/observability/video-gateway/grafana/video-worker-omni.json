      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 301,
          "title": "GPU 使用率（按 Worker Pod 平均）",
          "type": "timeseries",
          "description": "DCGM 各 GPU 使用率的算术平均，单位 %；平均值可能掩盖单卡不均衡。 按视频 Worker 专属容量指标识别 Pod，并应用 Namespace/workflow/model/pod 筛选；不依赖 Job 名称，不纳入其它模型服务。需要同一数据源采集对应基础设施指标并保留 namespace、pod 标签；缺失时显示 No data，不补零。身份匹配使用回看窗口，不能保证保留已超出窗口的旧 Pod。",
          "datasource": {
            "type": "prometheus",
            "uid": "${data_source}"
