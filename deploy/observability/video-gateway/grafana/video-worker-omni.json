{
  "uid": "dingo-video-worker",
  "title": "Video Worker and Omni",
  "tags": [
    "dingo",
    "video",
    "vllm-omni"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Shanghai",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "data_source",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${data_source}"
        },
        "query": {
          "query": "label_values(dingo_video_worker_detached_execution_capacity, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(dingo_video_worker_detached_execution_capacity, namespace)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "workflow",
        "label": "workflow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${data_source}"
        },
        "query": {
          "query": "label_values(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\"},workflow)",
          "refId": "workflow"
        },
        "definition": "label_values(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\"},workflow)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "model",
        "label": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${data_source}"
        },
        "query": {
          "query": "label_values(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\"},model)",
          "refId": "model"
        },
        "definition": "label_values(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\"},model)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${data_source}"
        },
        "query": {
          "query": "label_values(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",model=~\"$model\"},pod)",
          "refId": "pod"
        },
        "definition": "label_values(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",model=~\"$model\"},pod)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "执行数 / 执行容量",
      "type": "timeseries",
      "description": "取得执行许可至 Worker 执行/终态持久化结束；不是 GPU 利用率。",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dingo_video_worker_detached_execution_active{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}",
          "legendFormat": "{{workflow}} / {{pod}} / active"
        },
        {
          "refId": "B",
          "expr": "dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}",
          "legendFormat": "{{workflow}} / {{pod}} / capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "预取等待 / 预取容量",
      "type": "timeseries",
      "description": "Worker 已接收、等待执行许可的任务数。",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dingo_video_worker_detached_prefetch_waiting{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}",
          "legendFormat": "{{workflow}} / {{pod}} / waiting"
        },
        {
          "refId": "B",
          "expr": "dingo_video_worker_detached_prefetch_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}",
          "legendFormat": "{{workflow}} / {{pod}} / capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Worker 终态速率",
      "type": "timeseries",
      "description": "按workflow、Pod、outcome展示Worker终态速率，按attempt/执行计数；不等于Gateway最终业务状态。不同Pod显示独立曲线。",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(workflow,pod,outcome) (rate(dingo_video_worker_detached_tasks_total{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval]))",
          "interval": "15s",
          "legendFormat": "{{workflow}} / {{pod}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Worker 执行平均 / P95",
      "type": "timeseries",
      "description": "所选Worker的执行平均/P95，按workflow聚合；含Worker输出处理，不包含预取等待。P95为直方图桶内估算，低样本仅供参考；不同请求参数的样本会混合统计。",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(workflow) (rate(dingo_video_worker_detached_execution_seconds_sum{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval])) / sum by(workflow) (rate(dingo_video_worker_detached_execution_seconds_count{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval]))",
          "interval": "15s",
          "legendFormat": "{{workflow}} / mean"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le,workflow) (rate(dingo_video_worker_detached_execution_seconds_bucket{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval])))",
          "interval": "15s",
          "legendFormat": "{{workflow}} / P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "峰值显存（Omni MB）",
      "type": "timeseries",
      "description": "Omni上报的峰值显存，单位沿用原生MB；不是实时GPU显存、GPU利用率，也不是DCGM全卡显存。",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vllm_omni:peak_memory_mb{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}",
          "legendFormat": "{{workflow}} / {{pod}} / stage {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:MB",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "Worker 采集可用性 / 采集耗时",
      "type": "timeseries",
      "description": "左轴UP：1=指标抓取成功，0=抓取失败，不等于模型业务就绪；右轴scrape duration：单次抓取耗时（秒）。按workflow和Pod筛选，不受model筛选影响，因为采集目标是整个Pod。无目标时可无序列，不补0。 不限定采集 Job；通过相同 namespace、instance 上的视频 Worker 专属指标识别目标，保留最近 1 小时内识别到的实例。未曾成功采集或超过 1 小时无专属指标的目标不会显示。 不限定采集 Job；通过相同 namespace、instance 上的视频 Worker 专属指标识别目标，保留最近 1 小时内识别到的实例。未曾成功采集或超过 1 小时无专属指标的目标不会显示。",
      "datasource": {
        "type": "prometheus",
        "uid": "${data_source}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds{namespace=~\"$namespace\",pod=~\"$pod\"} and on(namespace,instance) max_over_time(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[1h])",
          "legendFormat": "{{pod}} / scrape"
        },
        {
          "refId": "B",
          "expr": "up{namespace=~\"$namespace\",pod=~\"$pod\"} and on(namespace,instance) max_over_time(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[1h])",
          "legendFormat": "{{pod}} / UP"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "right",
            "axisLabel": "scrape duration (s)"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              },
              {
                "id": "custom.axisLabel",
                "value": "UP (0/1)"
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Omni 诊断",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 5,
          "title": "Worker 预取等待平均 / P95",
          "type": "timeseries",
          "description": "所选Worker预取等待的平均/P95，按workflow聚合。P95为直方图桶内估算，缺失不补零。",
          "datasource": {
            "type": "prometheus",
            "uid": "${data_source}"
          },
          "gridPos": {
            "x": 0,
            "y": 25,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by(workflow) (rate(dingo_video_worker_detached_queue_wait_seconds_sum{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval])) / sum by(workflow) (rate(dingo_video_worker_detached_queue_wait_seconds_count{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval]))",
              "interval": "15s",
              "legendFormat": "{{workflow}} / mean"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95,sum by(le,workflow) (rate(dingo_video_worker_detached_queue_wait_seconds_bucket{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval])))",
              "interval": "15s",
              "legendFormat": "{{workflow}} / P95"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 1,
                "fillOpacity": 5,
                "showPoints": "never",
                "spanNulls": false
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 4,
          "title": "Omni 成功速率",
          "type": "timeseries",
          "description": "底层 Omni 原生结果口径。",
          "datasource": {
            "type": "prometheus",
            "uid": "${data_source}"
          },
          "gridPos": {
            "x": 12,
            "y": 25,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by(workflow,pod) (rate(vllm_omni:requests_success_total{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval]))",
              "interval": "15s",
              "legendFormat": "{{workflow}} / {{pod}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 1,
                "fillOpacity": 5,
                "showPoints": "never",
                "spanNulls": false
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 7,
          "title": "Omni E2E 平均",
          "type": "timeseries",
          "description": "Omni 请求范围，不含 Dingo 预取排队/Gateway 后处理。",
          "datasource": {
            "type": "prometheus",
            "uid": "${data_source}"
          },
          "gridPos": {
            "x": 0,
            "y": 33,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by(workflow) (rate(vllm_omni:e2e_request_latency_s_sum{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval])) / sum by(workflow) (rate(vllm_omni:e2e_request_latency_s_count{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval]))",
              "interval": "15s",
              "legendFormat": "{{workflow}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 1,
                "fillOpacity": 5,
                "showPoints": "never",
                "spanNulls": false
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 8,
          "title": "Omni stage 生成平均",
          "type": "timeseries",
          "description": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${data_source}"
          },
          "gridPos": {
            "x": 12,
            "y": 33,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by(workflow,stage) (rate(vllm_omni:stage_gen_time_s_sum{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval])) / sum by(workflow,stage) (rate(vllm_omni:stage_gen_time_s_count{namespace=~\"$namespace\",workflow=~\"$workflow\",pod=~\"$pod\",model=~\"$model\"}[$__rate_interval]))",
              "interval": "15s",
              "legendFormat": "{{workflow}} / stage {{stage}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 1,
                "fillOpacity": 5,
                "showPoints": "never",
                "spanNulls": false
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
