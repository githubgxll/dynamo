            "y": 66,
            "w": 12,
            "h": 6
          },
          "targets": [
            {
              "refId": "A",
              "expr": "(sum by(namespace,pod) (max by(namespace,pod,container) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\"$pod\"}[$__range])))) and on(namespace,pod) max by(namespace,pod) (max_over_time(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",model=~\"$model\",pod=~\"$pod\"}[$__range]))",
              "legendFormat": "{{namespace}} / {{pod}}",
              "instant": true,
              "range": false,
              "format": "table"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm"
          },
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true
                },
                "indexByName": {
                  "namespace": 0,
                  "pod": 1,
                  "Value": 2
                },
                "renameByName": {
                  "Value": "Restarts (estimated)"
                }
              }
            }
          ]
