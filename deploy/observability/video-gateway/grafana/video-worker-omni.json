            "x": 0,
            "y": 50,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "(avg by(namespace,pod) (max by(namespace,pod,UUID,gpu) (DCGM_FI_DEV_GPU_UTIL{namespace=~\"$namespace\",pod=~\"$pod\"}))) and on(namespace,pod) max by(namespace,pod) (max_over_time(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",model=~\"$model\",pod=~\"$pod\"}[$__range]))",
              "legendFormat": "{{namespace}} / {{pod}}",
              "instant": false,
              "range": true
