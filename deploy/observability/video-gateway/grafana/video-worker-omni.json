            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 302,
          "title": "GPU 显存占用（按 Worker Pod）",
          "type": "timeseries",
          "description": "各 GPU 已用显存之和 / 总显存之和；这是设备当前显存使用比例，与 Omni 峰值显存指标不同。 按视频 Worker 专属容量指标识别 Pod，并应用 Namespace/workflow/model/pod 筛选；不依赖 Job 名称，不纳入其它模型服务。需要同一数据源采集对应基础设施指标并保留 namespace、pod 标签；缺失时显示 No data，不补零。身份匹配使用回看窗口，不能保证保留已超出窗口的旧 Pod。",
          "datasource": {
            "type": "prometheus",
            "uid": "${data_source}"
          },
          "gridPos": {
            "x": 12,
            "y": 50,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "(sum by(namespace,pod) (max by(namespace,pod,UUID,gpu) (DCGM_FI_DEV_FB_USED{namespace=~\"$namespace\",pod=~\"$pod\"})) / (sum by(namespace,pod) (max by(namespace,pod,UUID,gpu) (DCGM_FI_DEV_FB_USED{namespace=~\"$namespace\",pod=~\"$pod\"})) + sum by(namespace,pod) (max by(namespace,pod,UUID,gpu) (DCGM_FI_DEV_FB_FREE{namespace=~\"$namespace\",pod=~\"$pod\"})))) and on(namespace,pod) max by(namespace,pod) (max_over_time(dingo_video_worker_detached_execution_capacity{namespace=~\"$namespace\",workflow=~\"$workflow\",model=~\"$model\",pod=~\"$pod\"}[$__range]))",
              "legendFormat": "{{namespace}} / {{pod}}",
              "instant": false,
              "range": true
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 1,
                "fillOpacity": 5,
                "showPoints": "never",
                "spanNulls": false
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              },
              "min": 0,
              "max": 1
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
