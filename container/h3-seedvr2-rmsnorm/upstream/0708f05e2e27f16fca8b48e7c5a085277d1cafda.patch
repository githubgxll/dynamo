Date: Mon, 12 Oct 2026 22:57:10 +0800
Subject: [PATCH] [Bugfix] Prevent FP16 overflow in SeedVR2 RMSNorm (#8767)

Signed-off-by: princepride <wangzhipeng628@gmail.com>
---
 .../models/seedvr2/test_seedvr2_norm.py       | 34 +++++++++++++++++++
 vllm_omni/diffusion/models/seedvr2/nadit.py   |  9 +++--
 2 files changed, 41 insertions(+), 2 deletions(-)
 create mode 100644 tests/diffusion/models/seedvr2/test_seedvr2_norm.py

diff --git a/tests/diffusion/models/seedvr2/test_seedvr2_norm.py b/tests/diffusion/models/seedvr2/test_seedvr2_norm.py
new file mode 100644
index 00000000000..b02a37259d3
--- /dev/null
+++ b/tests/diffusion/models/seedvr2/test_seedvr2_norm.py
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+import pytest
+import torch
+
+from vllm_omni.diffusion.models.seedvr2.nadit import RMSNorm
+
+pytestmark = [pytest.mark.core_model, pytest.mark.cpu]
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16, torch.float32])
+@pytest.mark.parametrize("affine", [False, True])
+def test_rms_norm_large_finite_inputs(dtype: torch.dtype, affine: bool) -> None:
+    # All inputs are finite in FP16, but squaring an outlier in FP16 yields
+    # infinity and silently zeros the entire normalized token.
+    x = torch.ones(2, 3, 2560, dtype=dtype)
+    x[0, 0, 0] = 256
+    x[0, 1, 0] = 300
+    x[0, 2, 0] = 60000
+    x[1, 0].fill_(300)
+    x[1, 1].zero_()
+    x[1, 2].fill_(0.0001)
+    norm = RMSNorm(2560, eps=1e-5, elementwise_affine=affine).to(dtype)
+    if affine:
+        with torch.no_grad():
+            norm.weight.copy_(torch.linspace(0.5, 1.5, 2560, dtype=dtype))
+    high_precision = x.double()
+    expected = (high_precision / (high_precision.square().mean(-1, keepdim=True) + norm.eps).sqrt()).to(dtype)
+    if affine:
+        expected = expected * norm.weight
+    actual = norm(x)
+    assert actual.dtype == dtype
+    assert actual.isfinite().all()
+    torch.testing.assert_close(actual, expected)
diff --git a/vllm_omni/diffusion/models/seedvr2/nadit.py b/vllm_omni/diffusion/models/seedvr2/nadit.py
index 3886ca37a7a..417dc4397a8 100644
--- a/vllm_omni/diffusion/models/seedvr2/nadit.py
+++ b/vllm_omni/diffusion/models/seedvr2/nadit.py
@@ -1479,7 +1479,7 @@ def forward(self, vid: torch.Tensor, txt: torch.Tensor | None, *args, **kwargs):
 
 
 class RMSNorm(nn.Module):
-    """Reference ``CustomRMSNorm``: normalise in the input dtype, optional affine."""
+    """RMS normalization with FP32 accumulation for low-precision inputs."""
 
     def __init__(self, dim: int, eps: float = 1e-5, elementwise_affine: bool = True) -> None:
         super().__init__()
@@ -1490,8 +1490,13 @@ def __init__(self, dim: int, eps: float = 1e-5, elementwise_affine: bool = True)
             self.register_parameter("weight", None)
 
     def forward(self, x: torch.Tensor) -> torch.Tensor:
+        input_dtype = x.dtype
+        # Squaring finite FP16 activations above ~256 overflows to infinity,
+        # silently zeroing the entire token when it is divided by the RMS.
+        if input_dtype in (torch.float16, torch.bfloat16):
+            x = x.float()
         variance = x.pow(2).mean(dim=-1, keepdim=True)
-        x = x / torch.sqrt(variance + self.eps)
+        x = (x / torch.sqrt(variance + self.eps)).to(input_dtype)
         if self.weight is not None:
             x = x * self.weight.to(x.dtype)
         return x
