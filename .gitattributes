*                   text  eol=lf
*.sln               text  eol=crlf
*.[Gg][Ii][Ff]      binary
*.[Ii][Cc][Oo]      binary
*.[Jj][Pp][Ee][Gg]  binary
*.[Jj][Pp][Gg]      binary
*.[Pp][Dd][Ff]      binary
*.[Pp][Nn][Gg]      binary
*.[Ww][Ee][Bb][Pp]  binary
*.[Zz][Ii][Pp]      binary
*.[Tt][Gg][Zz]      binary
*.[Gg][Zz]          binary
*.fatbin            binary
*.mp4               binary
*.woff2             binary -eol

# Exclude test data files from linguist language detection
lib/llm/tests/data/** linguist-vendored
lib/llm/tests/snapshots/** linguist-vendored

# Preserve the released vLLM proto byte-for-byte, including its trailing blank line.
lib/backend/vllm-sidecar/proto/vllm_grpc.proto -text diff whitespace=-blank-at-eof

# H3 evidence locks cover exact upstream bytes, including license whitespace.
container/h3-experimental/assets/legal/** -text -eol whitespace=-blank-at-eof,-blank-at-eol
container/h3-experimental/ref8/** -text -eol
# The sealed patch lock inherited CRLF; preserve its historical byte hash.
container/h3-experimental/ref8/patch.lock.json -text -eol whitespace=cr-at-eol
container/h3-experimental/profiles/fasth3_base_lock.json -text -eol
container/h3-experimental/profiles/base_verify.py -text -eol
container/h3-experimental/profiles/*.sh text eol=lf
